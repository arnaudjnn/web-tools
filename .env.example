# Server Authentication (required)
# Auto-generated on Railway deploy; set manually for local development.
API_KEY=your-api-key

# SearXNG Configuration
SEARXNG_URL=http://localhost:8080  # default: http://searxng.railway.internal:8080
SEARXNG_ENGINES=                  # Optional: Comma-separated engines (e.g. "google,brave,duckduckgo")
SEARXNG_CATEGORIES=               # Optional: Comma-separated categories (e.g. "general,science")

# Scrapling Configuration
# Serves web_fetch / web_html / web_crawl: fetching (residential egress +
# JS-challenge solving), HTML→markdown rendering, and screenshot/pdf/JS
# execution for web_screenshot / web_pdf / web_execute_js.
SCRAPLING_URL=http://localhost:8000  # default: http://scrapling.railway.internal:8000

# Camoufox Configuration
# Serves web_fetch / web_html / web_screenshot for hosts that need an Italian
# residential visitor, plus web_bytes, web_eval, web_spa_fetch and web_recycle.
# Is also the fetch fallback when Scrapling is unreachable.
CAMOUFOX_URL=http://localhost:8001  # default: http://camoufox.railway.internal:8000

# Proxy Configuration (optional)
# Set on the SearXNG and Scrapling services, NOT on the server. Must be a rotating
# residential pool; for SearXNG it must geo-target US (see services/searxng/settings.yml).
# PROXY_URL=http://user:pass@proxy-host:port
